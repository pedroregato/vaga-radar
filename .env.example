# Copie para .env e preencha. O .env nunca vai para o git.

# N8N
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria
GENERIC_TIMEZONE=America/Sao_Paulo

# LLM (usado pelo pacote radar/ nos testes de calibração)
LLM_PROVIDER=gemini            # gemini | anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Supabase e Telegram ficam como credenciais dentro do N8N, não aqui.
